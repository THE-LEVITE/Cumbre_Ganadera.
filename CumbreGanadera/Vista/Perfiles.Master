<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Perfiles.master.cs" Inherits="CumbreGanadera.Vista.Perfiles.Perfiles" %>

<!DOCTYPE html>
<html>
<head runat="server">
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
    <title>
        <asp:ContentPlaceHolder ID="title" runat="server"></asp:ContentPlaceHolder>
    </title>
    <asp:ContentPlaceHolder ID="head" runat="server"></asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">
        <!-- Menú de navegación -->
        <nav class="navbar navbar-expand-lg bg-white shadow-sm sticky-top">
            <div class="container">
                <a class="navbar-brand fw-bold text-success" href="#">Cumbre Ganadera</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarMain">
                    <ul class="navbar-nav mx-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <asp:LinkButton ID="lnkInicio" runat="server" CssClass="nav-link" OnClick="lnkInicio_Click">Inicio</asp:LinkButton>
                        </li>
                        <li class="nav-item">
                            <asp:LinkButton ID="lnkPerfil" runat="server" CssClass="nav-link active fw-semibold" OnClick="lnkPerfil_Click">Perfil</asp:LinkButton>
                        </li>
                        <li class="nav-item">
                            <asp:LinkButton ID="lnkAyuda" runat="server" CssClass="nav-link" OnClick="lnkAyuda_Click">Ayuda</asp:LinkButton>
                        </li>
                    </ul>
                    <div class="d-flex align-items-center">
                        <asp:Label ID="lblNombreUsuario" runat="server" CssClass="me-2 text-dark fw-semibold"></asp:Label>
                        <asp:ImageButton ID="imgPerfil" runat="server"
                            ImageUrl="../Source/Img/Perfiles/Cliente/fotoP.jpg"
                            CssClass="rounded-circle"
                            Style="width: 32px; height: 32px; cursor: pointer;"
                            OnClick="imgPerfil_Click" />
                    </div>
                </div>
            </div>
        </nav>

        <!-- Contenido de cada página hija -->
        <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server"></asp:ContentPlaceHolder>
    </form>
</body>
</html>